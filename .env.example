# Supabase client credentials (safe to expose — the anon key is gated by RLS).
# In production these are injected automatically by the Supabase Vercel
# Marketplace integration. For local dev, copy this file to `.env.local` and
# fill in the values from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Show the "email me a sign-in link" option on the login screen. Off unless this
# is exactly 'true'. Magic links need working SMTP — Supabase's built-in mailer
# allows only a couple of messages an hour — so while accounts are provisioned
# with passwords (scripts/create-beta-user.mjs) the option stays hidden. Set it
# to true once custom SMTP is configured; no code change needed.
# VITE_ENABLE_MAGIC_LINK=true

# Server-only — used ONLY by scripts/migrate-data.mjs to import legacy data.
# NEVER prefix this with VITE_ and never commit the real value.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# TARGET_USER_ID=the-auth-user-uuid
